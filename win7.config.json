{
  "appId": "com.message.messenger",
  "productName": "Message",
  "copyright": "Copyright 2026 Message",
  "directories": {
    "output": "out/win7"
  },
  "files": [
    "dist/**/*",
    "!**/node_modules/**"
  ],
  "npmRebuild": false,
  "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "asar": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${productName} Setup Win7 ${version}.${ext}"
  },
  "portable": {
    "artifactName": "${productName} Win7 ${version}.${ext}"
  },
  "extraMetadata": {
    "name": "message"
  }
}