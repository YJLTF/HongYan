{
  "name": "hongyan",
  "version": "1.0.0",
  "description": "HongYan LAN P2P Messenger",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win",
    "package:portable": "electron-vite build && electron-builder --win --config.portable",
    "package:nsis": "electron-vite build && electron-builder --win --config.nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "lan",
    "p2p",
    "messenger",
    "chat"
  ],
  "author": "HongYan",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "electron-log": "^5.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "pinia": "^2.2.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  },
  "build": {
    "appId": "com.hongyan.messenger",
    "productName": "HongYan",
    "copyright": "Copyright 2026 HongYan",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*"
    ],
    "icon": "build/icons/256x256.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "electronLanguages": [
        "en-US"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HongYan"
    },
    "portable": {
      "artifactName": "HongYan-Portable-${version}.${ext}"
    },
    "extraResources": [],
    "asar": true
  }
}
