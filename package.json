{
  "name": "hongyan",
  "version": "1.0.0",
  "description": "HongYan LAN P2P Messenger",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test:two": "powershell -ExecutionPolicy Bypass -File test-two-instances.ps1",
    "test:two:bat": "test-two-instances.bat",
    "package": "cross-env NODE_ENV=production electron-vite build && electron-builder --win",
    "package:portable": "cross-env NODE_ENV=production electron-vite build && electron-builder --win portable",
    "package:nsis": "cross-env NODE_ENV=production electron-vite build && electron-builder --win nsis"
  },
  "keywords": [
    "lan",
    "p2p",
    "messenger",
    "chat"
  ],
  "author": "YJLTF",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "lowdb": "^7.0.1",
    "electron-log": "^5.1.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "pinia": "^2.2.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  },
  "build": {
    "appId": "com.hongyan.messenger",
    "productName": "HongYan",
    "copyright": "Copyright 2026 HongYan",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*"
    ],
    "npmRebuild": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "asar": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
